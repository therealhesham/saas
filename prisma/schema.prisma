generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  /// معرّف نصّي يستخدم في الرابط، لازم يكون فريد
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  tagline     String   @db.VarChar(160)
  description String   @db.Text
  /// اسم أيقونة من lucide-react، بيتحوّل لمكوّن عبر allowlist في lib/product-icons.ts
  icon        String   @default("Blocks") @db.VarChar(60)
  /// مفتاح لون من ثوابت PRODUCT_ACCENTS
  accent      String   @default("sky") @db.VarChar(20)
  /// النقاط المميزة، متخزنة JSON عشان MySQL مابيدعمش مصفوفات
  highlights  Json
  /// ترتيب العرض في الصفحة، الأقل يظهر الأول
  position    Int      @default(0)
  /// لو false المنتج بيتخفي من الصفحة من غير حذف
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, position])
}

model Solution {
  id          Int      @id @default(autoincrement())
  /// معرّف نصّي فريد للرابط
  slug        String   @unique @db.VarChar(80)
  /// الوسم القصير مثل "الاستقدام"
  tag         String   @db.VarChar(60)
  title       String   @db.VarChar(120)
  subtitle    String   @db.VarChar(200)
  description String   @db.Text
  /// لون HEX للـ accent — مثلاً "#3B5BDB"
  accentColor String   @default("#3B5BDB") @db.VarChar(20)
  /// نقاط الميزات — JSON Array من {icon: string, text: string}
  features    Json
  /// نص زر الدعوة للعمل
  ctaText     String   @default("استكشف الحل") @db.VarChar(80)
  /// رابط زر الدعوة للعمل
  ctaHref     String   @default("#") @db.VarChar(255)
  /// ترتيب العرض
  position    Int      @default(0)
  /// لو false الحل بيتخفى من الصفحة
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, position])
}

model Project {
  id          Int      @id @default(autoincrement())
  /// معرّف نصّي فريد في الرابط
  slug        String   @unique @db.VarChar(80)
  title       String   @db.VarChar(120)
  summary     String   @db.VarChar(255)
  description String   @db.Text
  category    String   @default("عام") @db.VarChar(60)
  /// رابط الصورة المرفوعة في Digital Ocean Spaces
  imageUrl    String   @db.Text
  /// رابط المشروع الحي
  projectUrl  String?  @db.VarChar(255)
  /// رابط مستودع GitHub
  githubUrl   String?  @db.VarChar(255)
  /// التقنيات المستعملة كـ JSON Array
  technologies Json
  /// ترتيب العرض في الصفحة
  position    Int      @default(0)
  /// حالة النشر
  published   Boolean  @default(true)
  /// مميز أو بارز في الصفحة الرئيسية
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, position])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  phone     String   @db.VarChar(50)
  email     String?  @db.VarChar(120)
  service   String?  @db.VarChar(100)
  message   String?  @db.Text
  status    String   @default("جديد") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

